# QSMS Environment Variables Template
# Copy to .env.local and replace placeholders with locally managed values.

# Authentication
AUTH_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# AI
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Supabase (primary project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Supabase (RAG project; use the primary project values if shared)
NEXT_PUBLIC_RAG_SUPABASE_URL=https://your-rag-project.supabase.co
NEXT_PUBLIC_RAG_SUPABASE_ANON_KEY=replace-with-public-anon-key
RAG_SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Google Apps Script integrations, when enabled
GAS_WEB_APP_URL=https://script.google.com/macros/s/replace-with-deployment-id/exec
GAS_CALENDAR_WEB_APP_URL=https://script.google.com/macros/s/replace-with-deployment-id/exec

# Cloudinary uploads, when enabled
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=replace-with-upload-preset
